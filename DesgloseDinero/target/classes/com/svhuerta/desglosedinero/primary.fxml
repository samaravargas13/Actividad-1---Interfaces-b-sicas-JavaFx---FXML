<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.svhuerta.desglosedinero.PrimaryController">

    <Label text="Desglose de Dinero"/>

    <Label text="Cantidad"/>

    <TextField fx:id="txtDinero"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Desglosar" onAction="#desglosar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>

    <TextArea fx:id="txtResultado"/>

</VBox>