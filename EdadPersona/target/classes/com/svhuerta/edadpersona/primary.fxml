<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.svhuerta.edadpersona.PrimaryController">

    <Label text="Edad de una Persona"/>

    <Label text="Fecha de nacimiento"/>

    <TextField fx:id="txtFecha"
               promptText="dd/mm/aaaa"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Calcular" onAction="#calcular"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>

    <Label fx:id="lblResultado"/>

</VBox>
