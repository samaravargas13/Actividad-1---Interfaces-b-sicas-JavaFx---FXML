<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="380.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.svhuerta.divisiones.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Ingrese un número" />
      <TextField fx:id="txtNumero" layoutX="150.0" layoutY="26.0" prefWidth="130.0" />
      <Button fx:id="btnAnalizar" layoutX="300.0" layoutY="26.0" onAction="#handleAnalizar" text="Analizar" />
      <Button fx:id="btnLimpiar" layoutX="380.0" layoutY="26.0" onAction="#handleLimpiar" text="Limpiar" />

      <Label layoutX="30.0" layoutY="85.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantCifras" editable="false" layoutX="190.0" layoutY="81.0" prefWidth="90.0" />

      <Label layoutX="30.0" layoutY="125.0" text="Suma de cifras impares" />
      <TextField fx:id="txtSumaImpares" editable="false" layoutX="190.0" layoutY="121.0" prefWidth="90.0" />

      <Label layoutX="30.0" layoutY="165.0" text="Suma de cifras pares" />
      <TextField fx:id="txtSumaPares" editable="false" layoutX="190.0" layoutY="161.0" prefWidth="90.0" />

      <Label layoutX="30.0" layoutY="205.0" text="Suma total de cifras" />
      <TextField fx:id="txtSumaTotal" editable="false" layoutX="190.0" layoutY="201.0" prefWidth="90.0" />

      <Label layoutX="30.0" layoutY="245.0" text="Cifra mayor" />
      <TextField fx:id="txtCifraMayor" editable="false" layoutX="190.0" layoutY="241.0" prefWidth="90.0" />

      <Label layoutX="30.0" layoutY="285.0" text="Cifra menor" />
      <TextField fx:id="txtCifraMenor" editable="false" layoutX="190.0" layoutY="281.0" prefWidth="90.0" />

      <Label layoutX="340.0" layoutY="85.0" text="Divisores" />
      <ListView fx:id="listDivisores" layoutX="340.0" layoutY="110.0" prefHeight="200.0" prefWidth="200.0" />
   </children>
</AnchorPane>